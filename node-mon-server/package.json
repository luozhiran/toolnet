{
  "name": "nodemonserver",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev:server": "cd server && cross-env DEBUG=app:* nodemon server.js",
    "dev:client": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "cd frontend && npm run build",
    "postinstall": "npm run build:client",
    "start": "node server/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "cors": "^2.8.6",
    "debug": "^4.3.4",
    "express": "^5.2.1",
    "morgan": "^1.11.0",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "nodemon": "^3.0.1"
  }
}

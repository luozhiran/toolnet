<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/network_scene_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NetworkSceneActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="96dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Network Scenes"
                android:textColor="#111827"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Use these buttons to send requests to node-mon-server, then open the floating result panel."
                android:textColor="#6B7280"
                android:textSize="13sp" />

            <TextView
                style="@style/NetworkSceneSectionTitle"
                android:text="Callback requests" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_net_get"
                style="@style/NetworkSceneButton"
                android:text="net GET callback" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_net_post"
                style="@style/NetworkSceneButton"
                android:text="net POST JSON callback" />

            <TextView
                style="@style/NetworkSceneSectionTitle"
                android:text="Flow requests" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_flow_get"
                style="@style/NetworkSceneButton"
                android:text="net-flow GET" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_flow_post"
                style="@style/NetworkSceneButton"
                android:text="net-flow POST JSON" />

            <TextView
                style="@style/NetworkSceneSectionTitle"
                android:text="Downloads" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_net_download"
                style="@style/NetworkSceneButton"
                android:text="net download callback" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_flow_download"
                style="@style/NetworkSceneButton"
                android:text="net-flow download" />

            <TextView
                style="@style/NetworkSceneSectionTitle"
                android:text="Retrofit" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_retrofit_suspend"
                style="@style/NetworkSceneButton"
                android:text="net-retrofit suspend" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_retrofit_flow"
                style="@style/NetworkSceneButton"
                android:text="net-retrofit Flow" />

            <TextView
                style="@style/NetworkSceneSectionTitle"
                android:text="Batch" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_run_all"
                style="@style/NetworkSceneButton"
                android:text="Run all scenes" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>

    <TextView
        android:id="@+id/btn_result_bubble"
        android:layout_width="40dp"
        android:layout_height="72dp"
        android:layout_gravity="start|top"
        android:layout_marginTop="240dp"
        android:background="@drawable/network_scene_log_handle"
        android:elevation="10dp"
        android:gravity="center"
        android:text="Log\n0"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/result_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/network_scene_result_panel"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_result_clear"
                style="@style/NetworkScenePanelButton"
                android:text="Clear" />

            <View
                android:id="@+id/result_panel_handle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/network_scene_drag_handle" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <ScrollView
            android:id="@+id/result_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tv_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:padding="12dp"
                android:textColor="#E5E7EB"
                android:textIsSelectable="true"
                android:textSize="12sp"
                tools:text="Network scene result" />
        </ScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
